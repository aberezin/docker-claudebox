#!/usr/bin/env bash
# Refuse ordinary commits on the default branch.
#
# WHY: the repo convention is one issue per branch, and the owner merges. On
# 2026-09-01 a test-isolation fix (a744f30) was committed and pushed straight to
# master mid-session — not maliciously, just momentum: the fix was small, the
# branch for the CURRENT task was the wrong home for it, and creating a third
# branch felt like ceremony. That is exactly when it happens.
#
# Discipline did not hold, so this does. Same reasoning as
# tests/test_deprecation_deadlines.sh: a rule nobody can forget beats a rule
# everybody means to keep.
#
# Merges are allowed — merging a finished branch INTO master is the workflow.
# Override for a genuine one-off with:  DRIDOCK_ALLOW_MASTER_COMMIT=1 git commit ...
#
# #103: this used to send you to <issue#>-<slug> unconditionally, which a RELEASE
# commit cannot satisfy — it closes no issue. The guard was right and its advice
# was impossible, leaving the next person a choice between an override they
# shouldn't spend and a branch name they'd invent. Hence release-X.Y.Z below.
#
# INSTALL VIA `make hooks`, which copies this into .git/hooks/.
# Do NOT rely on `core.hooksPath=.githooks` alone: that path is inside the
# worktree, so the hook vanishes on any branch that predates it — including
# master itself. Tested exactly that way and the guard silently did nothing,
# which is worse than no guard because you believe you are covered.
# .git/hooks/ lives outside the worktree and is therefore branch-independent.
set -uo pipefail

# #116: refuse an exec bit lost in passing. GNU `sed -i` on the virtiofs
# workspace mount renames a temp file over the original and the mode doesn't
# survive: a 755 script comes out 600, which git stages as 644. It cost
# entrypoint.sh its exec bit on #105 and #107, caught only by review both times.
# Runs on EVERY branch (unlike the master guard below): the flip lands on work
# branches. Deliberate removals are rare; override with DRIDOCK_ALLOW_MODE_CHANGE=1.
_lost_x=()
while IFS= read -r _f; do
    [ -n "$_f" ] && _lost_x+=("$_f")
done < <(git -c core.quotePath=false diff --cached --summary --no-renames \
           | sed -n 's/^ mode change 100755 => 100644 //p')
if [ "${#_lost_x[@]}" -gt 0 ]; then
    if [ "${DRIDOCK_ALLOW_MODE_CHANGE:-}" = "1" ]; then
        echo "⚠️  committing with the exec bit removed (DRIDOCK_ALLOW_MODE_CHANGE=1):" >&2
        printf '       %s\n' "${_lost_x[@]}" >&2
    else
        {
            echo "❌ refusing to commit: these files lose their exec bit (755 → 644):"
            printf '       %s\n' "${_lost_x[@]}"
            echo
            echo "   On the workspace mount this is usually \`sed -i\` (#116), not intent."
            echo "   Put the bit back and re-stage:"
            echo
            for _f in "${_lost_x[@]}"; do
                printf '       chmod +x %q && git add %q\n' "$_f" "$_f"
            done
            echo
            echo "   If removing it is deliberate:  DRIDOCK_ALLOW_MODE_CHANGE=1 git commit ..."
        } >&2
        exit 1
    fi
fi

_branch="$(git symbolic-ref --short -q HEAD || echo detached)"
case "$_branch" in
    master|main) ;;
    *) exit 0 ;;
esac

# A merge in progress is the sanctioned way commits land on master.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    exit 0
fi

if [ "${DRIDOCK_ALLOW_MASTER_COMMIT:-}" = "1" ]; then
    echo "⚠️  committing directly to '$_branch' (DRIDOCK_ALLOW_MASTER_COMMIT=1)." >&2
    exit 0
fi

cat >&2 <<EOF
❌ refusing to commit directly to '$_branch'.

   Work goes on a branch named <issue#>-<slug>, and the branch owner merges it.
   A standalone RELEASE commit (VERSION + dridockVersion.ts + CHANGELOG, nothing
   else) closes no issue, so it goes on release-X.Y.Z instead.
   See CLAUDE.md ("Work branches are named ...") and docs/versioning.md.

   Your staged changes are untouched. Move them to a branch:

       git switch -c <issue#>-<slug>      # ordinary work
       git switch -c release-X.Y.Z        # a version bump + changelog
       git commit ...

   If this genuinely belongs on '$_branch' (rare — a merge does not need this):

       DRIDOCK_ALLOW_MASTER_COMMIT=1 git commit ...
EOF
exit 1
